<Window x:Class="ScriptsPannel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Settings}"
        Width="720"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.Language}" />
    <ComboBox Grid.Row="1" Margin="0,6,0,14" Width="220" HorizontalAlignment="Left" FontSize="14"
              SelectedValue="{Binding Language}" SelectedValuePath="Tag">
      <ComboBoxItem Tag="ru" Content="Русский" />
      <ComboBoxItem Tag="en" Content="English" />
    </ComboBox>

    <TextBlock Grid.Row="2" Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.Theme}" />
    <ComboBox Grid.Row="3" Margin="0,6,0,18" Width="280" HorizontalAlignment="Left" FontSize="14"
              SelectedIndex="{Binding ThemeIndex}">
      <ComboBoxItem Content="{DynamicResource Str.ThemeLight}" />
      <ComboBoxItem Content="{DynamicResource Str.ThemeDark}" />
    </ComboBox>

    <TextBlock Grid.Row="4" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold"
               Text="{DynamicResource Str.ShelfBackgroundSection}" />
    <CheckBox Grid.Row="5" Margin="0,8,0,8" FontSize="14" Foreground="{DynamicResource Brush.Text}"
              Content="{DynamicResource Str.UseShelfBackground}" IsChecked="{Binding UseShelfBackground}" />
    <DockPanel Grid.Row="6" Margin="0,0,0,18">
      <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,8"
              Content="{DynamicResource Str.BrowseBg}" Command="{Binding BrowseBackgroundCommand}" />
      <TextBox Padding="10" FontSize="13" Text="{Binding CustomBackgroundPath, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>

    <TextBlock Grid.Row="7" Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.ScriptsPath}" />
    <DockPanel Grid.Row="8" Margin="0,6,0,14">
      <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,8"
              Content="{DynamicResource Str.BrowseFolder}" Command="{Binding BrowseScriptsFolderCommand}" />
      <TextBox Padding="10" FontSize="13" Text="{Binding ScriptsPath, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>

    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Margin="0,0,10,0" Style="{StaticResource AccentButton}" Content="{DynamicResource Str.Save}"
              Command="{Binding SaveCommand}"
              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
      <Button Style="{StaticResource ChromeButton}" Content="{DynamicResource Str.Cancel}"
              Command="{Binding CancelCommand}"
              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
    </StackPanel>
  </Grid>
</Window>
