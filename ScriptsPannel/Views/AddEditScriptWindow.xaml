<Window x:Class="ScriptsPannel.Views.AddEditScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.EditScriptTitle}"
        Width="760"
        Height="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Surface}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.ScriptName}" />
    <TextBox Grid.Row="1" Margin="0,6,0,12" Padding="10" FontSize="14"
             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="2" Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.Runtime}" />
    <ComboBox Grid.Row="3" Margin="0,6,0,12" FontSize="14" SelectedIndex="{Binding RuntimeIndex}">
      <ComboBoxItem Content="{DynamicResource Str.RuntimePs}" />
      <ComboBoxItem Content="{DynamicResource Str.RuntimeCmd}" />
      <ComboBoxItem Content="{DynamicResource Str.RuntimeCustom}" />
    </ComboBox>

    <StackPanel Grid.Row="4" Margin="0,0,0,12">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding RuntimeIndex}" Value="2">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.InterpreterPath}" />
      <DockPanel Margin="0,6,0,0">
        <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,8"
                Content="{DynamicResource Str.BrowseRunner}" Command="{Binding BrowseRunnerCommand}" />
        <TextBox Padding="10" Text="{Binding CustomRunnerPath, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
    </StackPanel>

    <TextBlock Grid.Row="5" Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource Str.ScriptBody}" />
    <TextBox Grid.Row="6" Margin="0,6,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             MinHeight="220" Padding="10" FontFamily="Consolas" FontSize="13"
             Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" />

    <StackPanel Grid.Row="7" Margin="0,6,0,0">
      <CheckBox FontSize="14" Foreground="{DynamicResource Brush.Text}"
                Content="{DynamicResource Str.RunAsAdmin}" IsChecked="{Binding RunAsAdministrator}" />
      <CheckBox Margin="0,10,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text}"
                Content="{DynamicResource Str.Autostart}" IsChecked="{Binding Autostart}" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                 Text="{DynamicResource Str.AutostartNote}" />

      <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Margin="0,0,10,0" Style="{StaticResource AccentButton}" Content="{DynamicResource Str.Save}"
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        <Button Style="{StaticResource ChromeButton}" Content="{DynamicResource Str.Cancel}"
                Command="{Binding CancelCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
