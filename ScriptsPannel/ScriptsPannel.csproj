<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>ScriptsPannel</RootNamespace>
    <AssemblyName>ScriptsPannel</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>ScriptsPannel</Authors>
    <Description>Панель полок и скриптов для Windows</Description>
    <!-- Положите app.ico в папку Assets рядом с этим файлом (см. README). -->
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
</Project>
